{
	"name": "@proxie-studio/better-auth-tenant-kit",
	"version": "0.2.0",
	"description": "Multi-tenant Better Auth + Convex client/server wrapper for SvelteKit apps — one createPlatformAuth() call instead of configuring Better Auth and the Convex client by hand in every app.",
	"license": "MIT",
	"author": {
		"name": "Ghanshyam Singh Shaktawat",
		"email": "ghanshyam.dev@weareproxie.com",
		"url": "https://github.com/proxie-ghanshyam"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proxie-studio/better-auth-tenant-kit.git"
	},
	"homepage": "https://github.com/proxie-studio/better-auth-tenant-kit#readme",
	"bugs": {
		"url": "https://github.com/proxie-studio/better-auth-tenant-kit/issues"
	},
	"keywords": [
		"better-auth",
		"convex",
		"sveltekit",
		"svelte",
		"multi-tenant",
		"auth",
		"authentication"
	],
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"@sveltejs/kit": "^2.0.0",
		"better-auth": "^1.6.0",
		"@convex-dev/better-auth": "^0.12.0",
		"convex": "^1.42.0",
		"convex-svelte": "^0.14.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@convex-dev/better-auth": "^0.12.5",
		"better-auth": "^1.6.25",
		"convex": "^1.42.3",
		"convex-svelte": "^0.14.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
